{
	"name": "davitec/dv-swift-pagetree",
	"description": "Faster TYPO3 Pagetree",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"version": "13.4.1",
	"authors": [
		{
			"name": "Daniel Schöne",
			"email": "ds@davitec.de"
		}
	],
	"require": {
		"typo3/cms-core": "~13.4.0"
	},
	"replace": {
